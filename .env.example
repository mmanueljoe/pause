# Copy to .env.local and fill in. Never commit .env files.

# Solana RPC endpoint for the website. Leave empty to use the public devnet URL
# (https://api.devnet.solana.com). For the live demo, use a private devnet URL
# from a provider such as Helius, QuickNode or Alchemy.
VITE_SOLANA_RPC_URL=

# Supabase backend (names, invites, alerts). Find both in the Supabase
# dashboard: Project Settings > API (URL) and API Keys (publishable key).
# They're public values, but keep them in .env.local, not in git.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

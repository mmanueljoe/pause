# Copy to .env.local and fill in. Never commit .env files.

# Solana RPC endpoint for the website. Leave empty to use the public devnet URL
# (https://api.devnet.solana.com). For the live demo, use a private devnet URL
# from a provider such as Helius, QuickNode or Alchemy.
VITE_SOLANA_RPC_URL=

# Supabase backend (names, invites, alerts). Both values are public: they
# only let the website call our Edge Functions, which check wallet signatures.
VITE_SUPABASE_URL=https://amnutfubtqkfavrfqejk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_x3hSHiqYOjJhGHqzcE3HIg_ome4TR24

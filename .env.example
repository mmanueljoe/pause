# Copy to .env.local and fill in. Never commit .env files.

# Solana RPC endpoint for the website. Leave empty to use the public devnet URL
# (https://api.devnet.solana.com). For the live demo, use a private devnet URL
# from a provider such as Helius, QuickNode or Alchemy.
VITE_SOLANA_RPC_URL=

# Supabase (guardian emails, alerts, automatic release). Added when the backend is built.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

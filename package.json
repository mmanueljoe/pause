{
  "name": "pause",
  "version": "0.0.0",
  "private": true,
  "description": "Pause: a Solana vault where every withdrawal waits, so the owner or a trusted guardian can stop it",
  "keywords": [
    "solana",
    "anchor",
    "vault",
    "guardian",
    "devnet"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "program:build": "cd anchor && anchor build --ignore-keys -- --features demo",
    "program:test": "npm run program:build && cd anchor && cargo test --features demo",
    "program:lint": "cd anchor && cargo fmt --all --check && cargo clippy --all-targets -- -D warnings && cargo clippy --all-targets --features demo -- -D warnings",
    "program:format": "cd anchor && cargo fmt --all",
    "codegen": "codama run js",
    "setup": "npm run program:build && npm run codegen",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{js,json,md,css,html,yml,yaml}": "prettier --write",
    "anchor/**/*.rs": "rustfmt --edition 2021"
  },
  "dependencies": {
    "@solana/client": "^1.2.0",
    "@solana/kit": "^5.1.0",
    "@solana/react-hooks": "^1.1.5",
    "@tailwindcss/vite": "^4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.3",
    "@codama/renderers-js": "1.7.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.3",
    "codama": "1.10.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6"
  }
}
